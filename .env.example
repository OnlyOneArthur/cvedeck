# CVEDeck secret configuration (development/documentation example).
# Runtime precedence: NVD_API_KEY process environment variable first,
# then ~/.config/cvedeck/.env (created with 0600 permissions, e.g. via the TUI).
# Never commit a real .env file; it is excluded in .gitignore.
NVD_API_KEY=your-nvd-api-key-here
